# Committed template. Real values live in .env.local, which is gitignored.
# Write them with: node scripts/set-ghl-env.mjs

# GoHighLevel sub-account (location) id for the Bright Hollow chat bot.
# NOT a secret: it ships publicly in the chat widget snippet on the site.
GHL_LOCATION_ID=

# GoHighLevel Private Integration Token for that sub-account.
# SECRET. Reads and writes contacts, calendars, and conversations.
# Never paste this into a chat, a commit, or a screenshot.
GHL_PIT_TOKEN=
